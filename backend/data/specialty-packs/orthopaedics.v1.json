  "formTemplates": [
    {
      "slug": "orthopaedic-intake",
      "name": "Orthopaedic Intake",
      "templateType": "onboarding",
      "categorySlug": "onboarding",
      "version": "1.0",
      "languages": [
        "en"
      ],
      "complianceTags": [
        "HIPAA"
      ],
      "fields": [
        {
          "id": "affected_area",
          "type": "select",
          "label": "Which area?",
          "options": [
            "Neck",
            "Shoulder",
            "Elbow",
            "Wrist or hand",
            "Back",
            "Hip",
            "Knee",
            "Ankle or foot"
          ],
          "required": true
        },
        {
          "id": "side",
          "type": "radio",
          "label": "Side",
          "options": [
            "Left",
            "Right",
            "Both",
            "Not applicable"
          ],
          "required": true
        },
        {
          "id": "how_started",
          "type": "textarea",
          "label": "How did it start? Include any injury",
          "required": true
        },
        {
          "id": "pain_score",
          "type": "scale",
          "label": "Pain at its worst, out of 10"
        },
        {
          "id": "worse_with",
          "type": "checkboxes",
          "label": "What makes it worse?",
          "options": [
            "Walking",
            "Stairs",
            "Standing",
            "Sitting",
            "Lifting",
            "At night",
            "Nothing in particular"
          ]
        },
        {
          "id": "walking_distance",
          "type": "text",
          "label": "How far can you walk before it stops you?"
        },
        {
          "id": "previous_surgery",
          "type": "textarea",
          "label": "Previous surgery or injections to this area"
        },
        {
          "id": "imaging",
          "type": "textarea",
          "label": "Any X-rays or scans already done, and where"
        },
        {
          "id": "physio",
          "type": "checkbox",
          "label": "Have you had physiotherapy for this?"
        },
        {
          "id": "medications",
          "type": "textarea",
          "label": "Painkillers and other medicines you take"
        }
      ]
    }
  ],
