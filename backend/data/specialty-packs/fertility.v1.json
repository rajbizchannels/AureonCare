  "formTemplates": [
    {
      "slug": "fertility-intake",
      "name": "Fertility Intake",
      "templateType": "onboarding",
      "categorySlug": "onboarding",
      "version": "1.0",
      "languages": [
        "en"
      ],
      "complianceTags": [
        "HIPAA"
      ],
      "fields": [
        {
          "id": "trying_duration",
          "type": "text",
          "label": "How long have you been trying to conceive?",
          "required": true
        },
        {
          "id": "previous_pregnancies",
          "type": "text",
          "label": "Previous pregnancies and outcomes"
        },
        {
          "id": "cycle_regular",
          "type": "radio",
          "label": "Are your periods regular?",
          "options": [
            "Yes",
            "No",
            "Not applicable"
          ]
        },
        {
          "id": "cycle_length",
          "type": "text",
          "label": "Usual cycle length"
        },
        {
          "id": "previous_treatment",
          "type": "textarea",
          "label": "Any fertility treatment already tried, and the outcome"
        },
        {
          "id": "conditions",
          "type": "checkboxes",
          "label": "Have you been told you have any of these?",
          "options": [
            "Polycystic ovaries",
            "Endometriosis",
            "Fibroids",
            "Blocked tubes",
            "Thyroid problem",
            "None of these"
          ]
        },
        {
          "id": "partner_assessment",
          "type": "radio",
          "label": "Has your partner had a semen analysis?",
          "options": [
            "Yes",
            "No",
            "Not applicable"
          ]
        },
        {
          "id": "smoking_alcohol",
          "type": "textarea",
          "label": "Smoking and alcohol, for both partners where it applies"
        },
        {
          "id": "medications",
          "type": "textarea",
          "label": "Current medicines and supplements"
        },
        {
          "id": "support_needs",
          "type": "textarea",
          "label": "Anything that would help us support you through treatment"
        }
      ]
    }
  ],
  "inventoryCategories": [
    {
