      "slug": "gp-new-patient-intake",
      "name": "New Patient Intake",
      "templateType": "onboarding",
      "categorySlug": "onboarding",
      "version": "1.0",
      "languages": [
        "en"
      ],
      "complianceTags": [
        "HIPAA"
      ],
      "fields": [
        {
          "id": "reason",
          "type": "textarea",
          "label": "What brings you in today?",
