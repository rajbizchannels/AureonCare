  "formTemplates": [
    {
      "slug": "diabetes-endocrine-intake",
      "name": "Diabetes and Endocrine Intake",
      "templateType": "onboarding",
      "categorySlug": "onboarding",
      "version": "1.0",
      "languages": [
        "en"
      ],
      "complianceTags": [
        "HIPAA"
      ],
      "fields": [
        {
          "id": "referral_reason",
          "type": "textarea",
          "label": "Reason for referral",
          "required": true
        },
        {
          "id": "diabetes_type",
          "type": "select",
          "label": "Diabetes",
          "options": [
            "None",
            "Type 1",
            "Type 2",
            "Gestational",
            "Other"
          ]
        },
        {
          "id": "year_diagnosed",
          "type": "text",
          "label": "Year diagnosed"
        },
        {
          "id": "current_treatment",
          "type": "checkboxes",
          "label": "Current treatment",
          "options": [
            "Diet only",
            "Tablets",
            "Injectables other than insulin",
            "Insulin",
            "Insulin pump"
          ]
        },
        {
          "id": "monitoring",
          "type": "select",
          "label": "How do you check your glucose?",
          "options": [
            "Not at all",
            "Finger prick",
            "Flash sensor",
            "Continuous monitor"
          ]
        },
        {
          "id": "hypos",
          "type": "text",
          "label": "Hypos in the last month, and whether you felt them coming"
        },
        {
          "id": "complications",
          "type": "checkboxes",
          "label": "Have you been told you have any of these?",
          "options": [
            "Eye changes",
            "Kidney changes",
            "Nerve damage",
            "Foot ulcer",
            "Heart disease"
          ]
        },
        {
          "id": "thyroid_symptoms",
          "type": "checkboxes",
          "label": "Any of these?",
          "options": [
            "Weight change",
            "Feeling hot or cold",
            "Palpitations",
            "Tiredness",
            "Hair or skin change",
            "Neck swelling"
          ]
        },
        {
          "id": "medications",
          "type": "textarea",
          "label": "Current medicines, with doses",
          "required": true
        }
      ]
    }
  ],
