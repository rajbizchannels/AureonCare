# API Configuration — point to your deployed Vercel backend
REACT_APP_SVC_URL=https://your-vercel-backend.vercel.app/api

# ─── Supabase (frontend / public access) ─────────────────────────────────────
# Supabase dashboard → Settings → API → Project URL & publishable key
REACT_APP_SB_URL=https://your-project-ref.supabase.co
REACT_APP_SB_PK=your-supabase-publishable-key

# OAuth Configuration
# Get these from your OAuth provider consoles

# Google OAuth
# Get from: https://console.cloud.google.com/apis/credentials
REACT_APP_GG_CID=your_google_client_id_here

# Microsoft OAuth (Azure AD)
# Get from: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
REACT_APP_MS_CID=your_microsoft_client_id_here

# Facebook OAuth
# Get from: https://developers.facebook.com/apps/
REACT_APP_FB_AID=your_facebook_app_id_here

# Redirect URI — must be the FRONTEND origin where this SPA runs, and must be
# registered as a redirect URI in the Microsoft/Azure app registration.
# Either name is accepted by the code (REACT_APP_REDIRECT_URI takes precedence).
REACT_APP_REDIRECT_URI=http://localhost:3000
# REACT_APP_AUTH_URI=http://localhost:3000  # legacy alias, still honored
