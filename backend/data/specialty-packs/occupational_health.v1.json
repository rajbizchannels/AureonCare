  "formTemplates": [
    {
      "slug": "occupational-health-questionnaire",
      "name": "Occupational Health Questionnaire",
      "templateType": "onboarding",
      "categorySlug": "onboarding",
      "version": "1.0",
      "languages": [
        "en"
      ],
      "complianceTags": [
        "HIPAA"
      ],
      "requireSignature": true,
      "fields": [
        {
          "id": "employer",
          "type": "text",
          "label": "Employer",
          "required": true
        },
        {
          "id": "job_title",
          "type": "text",
          "label": "Job title",
          "required": true
        },
        {
          "id": "job_tasks",
          "type": "textarea",
          "label": "Main tasks of the role",
          "required": true
        },
        {
          "id": "exposures",
          "type": "checkboxes",
          "label": "Does the role involve any of these?",
          "options": [
            "Noise",
            "Vibration",
            "Dust or fumes",
            "Chemicals",
            "Night work",
            "Driving",
            "Working at height",
            "Manual handling"
          ]
        },
        {
          "id": "conditions",
          "type": "textarea",
          "label": "Health conditions that could affect this work"
        },
        {
          "id": "medications",
          "type": "textarea",
          "label": "Current medicines"
        },
        {
          "id": "sickness_absence",
          "type": "text",
          "label": "Days of sickness absence in the last 12 months"
        },
        {
          "id": "adjustments",
          "type": "textarea",
          "label": "Any workplace adjustments you think would help"
        },
        {
          "id": "consent_to_report",
          "type": "checkbox",
          "label": "I understand a fitness-for-work report will be shared with my employer, and that it will not contain clinical details",
          "required": true
        }
      ]
    }
  ],
  "inventoryCategories": [
