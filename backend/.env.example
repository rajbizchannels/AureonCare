# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Public URL of the backend (used for OAuth redirect URIs)
APP_BASE_URL=https://your-vercel-backend.vercel.app
# Deployed frontend URL (used for CORS)
FRONTEND_URL=https://your-vercel-frontend.vercel.app

# ─── Supabase ────────────────────────────────────────────────────────────────
# Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key — safe to use in client-side code
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Secret key — server-side only, never expose to the browser
SUPABASE_SECRET_KEY=your-supabase-secret-key

# ─── Database (PostgreSQL via Supabase) ──────────────────────────────────────
# Supabase dashboard → Settings → Database → Connection string → URI
# Use the "Transaction Pooler" (port 6543) for Vercel serverless deployments.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# Individual vars — only used when DATABASE_URL is absent (local dev)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aureoncare
DB_USER=postgres
DB_PASSWORD=your-local-db-password
# Set to "true" when connecting to Supabase without DATABASE_URL
DB_SSL=false

# ─── Security ────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRATION=24h
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# ─── Redis (optional) ────────────────────────────────────────────────────────
USE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password

# ─── Email ────────────────────────────────────────────────────────────────────
# SENDGRID_API_KEY=your-sendgrid-key
# FROM_EMAIL=noreply@aureoncare.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
CLINIC_NAME=AureonCare Clinic

# ─── File uploads ─────────────────────────────────────────────────────────────
# On Vercel, use /tmp for transient uploads; persist to Supabase Storage.
UPLOAD_DIR=/tmp/aureoncare/uploads
MAX_FILE_SIZE=10485760

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_DIR=/tmp/aureoncare/logs
LOG_LEVEL=info

# ─── Zoom OAuth ──────────────────────────────────────────────────────────────
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret

# ─── Google Meet OAuth ───────────────────────────────────────────────────────
# GOOGLE_MEET_CLIENT_ID=your-google-client-id
# GOOGLE_MEET_CLIENT_SECRET=your-google-client-secret

# ─── Microsoft Teams / Azure AD ──────────────────────────────────────────────
# AZURE_AD_CLIENT_ID=your-azure-client-id
# AZURE_AD_CLIENT_SECRET=your-azure-client-secret

# ─── Cisco Webex ─────────────────────────────────────────────────────────────
# WEBEX_CLIENT_ID=your-webex-client-id
# WEBEX_CLIENT_SECRET=your-webex-client-secret
