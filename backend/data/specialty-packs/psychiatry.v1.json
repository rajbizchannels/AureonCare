  "formTemplates": [
    {
      "slug": "psychiatric-intake",
      "name": "Psychiatric Intake",
      "templateType": "onboarding",
      "categorySlug": "onboarding",
      "version": "1.0",
      "languages": [
        "en"
      ],
      "complianceTags": [
        "HIPAA"
      ],
      "fields": [
        {
          "id": "presenting_concern",
          "type": "textarea",
          "label": "What has brought you here?",
          "required": true
        },
        {
          "id": "duration",
          "type": "text",
          "label": "How long have you been feeling this way?"
        },
        {
          "id": "symptoms",
          "type": "checkboxes",
          "label": "Have you experienced any of these recently?",
          "options": [
            "Low mood",
            "Loss of interest",
            "Anxiety",
            "Panic attacks",
            "Sleep problems",
            "Appetite change",
            "Poor concentration",
            "Irritability",
            "Unusual experiences"
          ]
        },
        {
          "id": "previous_treatment",
          "type": "textarea",
          "label": "Previous mental health treatment, and what helped"
        },
        {
          "id": "current_medication",
          "type": "textarea",
          "label": "Medicines you take now, including anything for mental health"
        },
        {
          "id": "hospital_admissions",
          "type": "textarea",
          "label": "Any previous admissions to a mental health unit"
        },
        {
          "id": "substances",
          "type": "textarea",
          "label": "Alcohol, cannabis or other substances, and roughly how much"
        },
        {
          "id": "self_harm",
          "type": "radio",
          "label": "Have you had thoughts of harming yourself recently?",
          "options": [
            "No",
            "Yes, fleeting thoughts",
            "Yes, with a plan"
          ],
          "required": true
        },
        {
          "id": "support_network",
          "type": "textarea",
          "label": "Who do you turn to for support?"
        },
        {
          "id": "goals",
          "type": "textarea",
          "label": "What would you like to be different?"
        }
      ]
    }
  ],
