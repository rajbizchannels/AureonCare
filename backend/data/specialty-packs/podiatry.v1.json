  "formTemplates": [
    {
      "slug": "podiatry-intake",
      "name": "Podiatry Intake",
      "templateType": "onboarding",
      "categorySlug": "onboarding",
      "version": "1.0",
      "languages": [
        "en"
      ],
      "complianceTags": [
        "HIPAA"
      ],
      "fields": [
        {
          "id": "main_concern",
          "type": "textarea",
          "label": "What would you like us to look at?",
          "required": true
        },
        {
          "id": "which_foot",
          "type": "radio",
          "label": "Which foot?",
          "options": [
            "Left",
            "Right",
            "Both"
          ]
        },
        {
          "id": "pain_walking",
          "type": "checkbox",
          "label": "Does it hurt to walk?"
        },
        {
          "id": "diabetes",
          "type": "radio",
          "label": "Do you have diabetes?",
          "options": [
            "No",
            "Type 1",
            "Type 2"
          ],
          "required": true
        },
        {
          "id": "circulation",
          "type": "checkboxes",
          "label": "Have you been told you have any of these?",
          "options": [
            "Poor circulation",
            "Nerve damage in the feet",
            "Previous foot ulcer",
            "Previous amputation",
            "None of these"
          ]
        },
        {
          "id": "footwear",
          "type": "text",
          "label": "What footwear do you usually wear?"
        },
        {
          "id": "activity",
          "type": "text",
          "label": "Work and activity — how much are you on your feet?"
        },
        {
          "id": "self_care",
          "type": "radio",
          "label": "Can you reach and see your own feet?",
          "options": [
            "Yes",
            "With difficulty",
            "No"
          ]
        },
        {
          "id": "medications",
          "type": "textarea",
          "label": "Current medicines, including blood thinners"
        }
      ]
    }
  ],
  "inventoryCategories": [
    {
      "code": "pod_instruments",
      "name": "Podiatry Instruments"
    },
    {
      "code": "pod_orthotics",
      "name": "Orthotic Materials"
