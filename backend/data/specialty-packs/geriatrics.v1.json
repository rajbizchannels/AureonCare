  "formTemplates": [
    {
      "slug": "geriatric-assessment-intake",
      "name": "Geriatric Assessment Intake",
      "templateType": "onboarding",
      "categorySlug": "onboarding",
      "version": "1.0",
      "languages": [
        "en"
      ],
      "complianceTags": [
        "HIPAA"
      ],
      "fields": [
        {
          "id": "completed_by",
          "type": "select",
          "label": "Who is completing this form?",
          "options": [
            "The patient",
            "A relative",
            "A carer"
          ],
          "required": true
        },
        {
          "id": "living_situation",
          "type": "select",
          "label": "Living situation",
          "options": [
            "Alone",
            "With a partner",
            "With family",
            "Residential care",
            "Nursing home"
          ],
          "required": true
        },
        {
          "id": "mobility",
          "type": "select",
          "label": "Mobility",
          "options": [
            "Independent",
            "Walking stick",
            "Walking frame",
            "Wheelchair",
            "Bed-bound"
          ],
          "required": true
        },
        {
          "id": "falls_12m",
          "type": "number",
          "label": "Falls in the last 12 months"
        },
        {
          "id": "memory_concerns",
          "type": "checkbox",
          "label": "Are there concerns about memory?"
        },
        {
          "id": "adls",
          "type": "checkboxes",
          "label": "Which of these need help?",
          "options": [
            "Washing",
            "Dressing",
            "Toileting",
            "Eating",
            "Moving about",
            "Managing medicines",
            "Shopping",
            "Cooking"
          ]
        },
        {
          "id": "continence",
          "type": "select",
          "label": "Continence",
          "options": [
            "Continent",
            "Occasional accidents",
            "Incontinent of urine",
            "Incontinent of both"
          ]
        },
        {
          "id": "carer_name",
          "type": "text",
          "label": "Main carer, and their contact number"
        },
        {
          "id": "advance_directive",
          "type": "radio",
          "label": "Is there an advance decision or living will?",
          "options": [
            "Yes",
            "No",
            "Not sure"
          ]
        }
      ]
    }
  ],
  "inventoryCategories": [
    {
      "code": "ger_assessment",
      "name": "Assessment Tools"
    },
    {
      "code": "ger_mobility",
