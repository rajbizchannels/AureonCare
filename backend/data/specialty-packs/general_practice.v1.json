          "type": "textarea",
          "label": "Allergies and what happens"
        },
        {
          "id": "surgeries",
          "type": "textarea",
          "label": "Previous operations"
        },
        {
          "id": "family_history",
          "type": "textarea",
          "label": "Conditions that run in your family"
        },
        {
          "id": "smoking",
          "type": "radio",
          "label": "Do you smoke?",
          "options": [
            "Never",
            "Ex-smoker",
            "Current smoker"
          ]
        },
        {
          "id": "alcohol",
          "type": "text",
          "label": "Alcohol in a typical week"
        },
        {
          "id": "exercise",
