# Dependencies
node_modules/
*/node_modules/
**/node_modules/

# Git
.git/
.gitignore

# Environment files (never bake secrets into images)
.env
.env.*
**/.env
**/.env.*
!**/.env.example

# Logs
*.log
logs/
**/logs/

# Documentation
*.md
docs/
helm/
deployment/

# CI/CD
.github/

# Test artifacts
coverage/
.nyc_output/
**/coverage/
**/.nyc_output/

# Build outputs (will be built inside container)
dist/
build/
**/dist/
**/build/

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Docker files (avoid recursive inclusion)
docker/

# Python scripts (not needed in containers)
*.py

# Office documents
*.docx
*.pptx
*.xlsx

# Temporary files
*.tmp
*.bak
