  "formTemplates": [
    {
      "slug": "paediatric-intake",
      "name": "Paediatric Intake",
      "templateType": "onboarding",
      "fields": [
        {
          "id": "guardian_name",
          "type": "text",
          "label": "Parent or guardian completing this form",
          "required": true
        },
        {
          "id": "relationship",
          "type": "select",
          "label": "Relationship to the child",
          "options": [
            "Mother",
            "Father",
            "Grandparent",
            "Legal guardian",
            "Other"
          ],
          "required": true
        },
        {
          "id": "reason_for_visit",
          "type": "textarea",
          "label": "Reason for today's visit",
          "required": true
        },
        {
          "id": "birth_weight",
          "type": "text",
          "label": "Birth weight"
        },
        {
          "id": "gestation_weeks",
          "type": "number",
          "label": "Weeks of gestation at birth"
        },
        {
          "id": "delivery_type",
          "type": "radio",
          "label": "Type of delivery",
          "options": [
            "Vaginal",
            "Caesarean"
          ]
        },
        {
          "id": "feeding",
          "type": "radio",
          "label": "Feeding",
          "options": [
            "Breast",
            "Formula",
            "Mixed",
            "Solids"
          ]
        },
        {
          "id": "immunisations_up_to_date",
          "type": "radio",
          "label": "Are immunisations up to date?",
          "options": [
            "Yes",
            "No",
            "Not sure"
          ],
          "required": true
        },
        {
          "id": "allergies",
          "type": "textarea",
          "label": "Known allergies"
        },
        {
          "id": "school_nursery",
          "type": "text",
          "label": "School or nursery"
        }
      ]
    },
    {
      "slug": "paediatric-guardian-consent",
      "name": "Guardian Consent to Treatment",
      "templateType": "consent",
      "requireSignature": true,
      "fields": [
        {
          "id": "child_name",
          "type": "text",
          "label": "Child's full name",
          "required": true
        },
        {
          "id": "guardian_name",
          "type": "text",
          "label": "Parent or guardian name",
          "required": true
        },
        {
          "id": "relationship",
          "type": "text",
          "label": "Relationship to the child",
          "required": true
        },
        {
          "id": "has_parental_responsibility",
          "type": "checkbox",
          "label": "I confirm I hold parental responsibility for this child",
          "required": true
        },
        {
          "id": "treatment_explained",
          "type": "checkbox",
          "label": "The proposed treatment and its alternatives have been explained to me",
          "required": true
        },
        {
          "id": "questions_answered",
          "type": "checkbox",
          "label": "I have had the chance to ask questions and they were answered",
          "required": true
        }
      ]
    },
    {
      "slug": "paediatric-immunisation-record",
      "name": "Immunisation Record",
      "templateType": "clinical",
      "fields": [
        {
          "id": "vaccine",
          "type": "text",
          "label": "Vaccine given",
          "required": true
        },
        {
          "id": "dose_number",
          "type": "number",
          "label": "Dose number"
        },
        {
          "id": "site",
          "type": "select",
          "label": "Site",
          "options": [
            "Left thigh",
            "Right thigh",
            "Left arm",
            "Right arm",
            "Oral"
          ],
          "required": true
        },
        {
          "id": "batch_number",
          "type": "text",
          "label": "Batch number",
          "required": true
        },
        {
          "id": "expiry",
          "type": "date",
          "label": "Expiry date"
        },
        {
          "id": "guardian_informed_of_reactions",
          "type": "checkbox",
          "label": "Guardian advised what reactions to look out for",
          "required": true
        },
        {
          "id": "next_due",
          "type": "date",
          "label": "Next dose due"
        }
      ]
    },
    {
      "slug": "pediatric-wellness-intake",
      "name": "Pediatric Wellness Intake",
      "description": "Well-child visit questionnaire including developmental milestones, feeding, sleep, and behavioral concerns.",
      "templateType": "onboarding",
      "categorySlug": "pediatrics",
      "version": "1.1",
      "subcategory": "Well-Child Visit",
      "requireSignature": true,
      "languages": [
        "en",
        "es"
      ],
      "tags": [
        "pediatrics",
        "well-child",
        "developmental",
        "immunization"
      ],
      "complianceTags": [
        "HIPAA"
      ],
      "fields": [
        {
          "id": "child_name",
          "type": "text",
          "label": "Child's Full Name",
          "required": true
        },
        {
          "id": "child_dob",
          "type": "date",
          "label": "Child's Date of Birth",
          "required": true
        },
        {
          "id": "parent_name",
          "type": "text",
          "label": "Parent / Guardian Name",
          "required": true
        },
        {
          "id": "parent_relationship",
          "type": "select",
          "label": "Relationship to Child",
          "required": true,
          "options": [
            "Mother",
            "Father",
            "Legal Guardian",
            "Other"
          ]
        },
        {
          "id": "heading_development",
          "type": "heading",
          "label": "Developmental History"
        },
        {
          "id": "birth_complications",
          "type": "select",
          "label": "Birth complications?",
          "required": false,
          "options": [
            "None",
            "Premature birth",
            "NICU stay",
            "Delivery complications",
            "Other"
          ]
        },
        {
          "id": "developmental_concerns",
          "type": "textarea",
          "label": "Any developmental concerns? (speech, motor, learning)",
          "required": false
        },
        {
          "id": "heading_nutrition",
          "type": "heading",
          "label": "Nutrition & Feeding"
        },
        {
          "id": "feeding_type",
          "type": "select",
          "label": "Feeding method",
          "required": false,
          "options": [
            "Breastfed",
            "Formula",
            "Table food",
            "Mix"
          ]
        },
        {
          "id": "diet_concerns",
          "type": "textarea",
          "label": "Any feeding or dietary concerns?",
          "required": false
        },
        {
          "id": "heading_sleep",
          "type": "heading",
          "label": "Sleep"
        },
        {
          "id": "sleep_hours",
          "type": "select",
          "label": "Hours of sleep per night",
          "required": false,
          "options": [
            "Less than 8",
            "8-10",
            "10-12",
            "More than 12"
          ]
        },
        {
          "id": "sleep_concerns",
          "type": "textarea",
          "label": "Any sleep concerns?",
          "required": false
        },
        {
          "id": "heading_immunizations",
          "type": "heading",
          "label": "Immunizations"
        },
        {
          "id": "immunizations_uptodate",
          "type": "select",
          "label": "Are immunizations up to date?",
          "required": true,
          "options": [
            "Yes",
            "No",
            "Unknown"
          ]
        },
        {
          "id": "immunization_concerns",
          "type": "textarea",
          "label": "Any immunization concerns or refusals?",
          "required": false
        },
        {
          "id": "signature",
          "type": "signature",
          "label": "Parent / Guardian Signature",
          "required": true
        }
      ]
    }
  ],
