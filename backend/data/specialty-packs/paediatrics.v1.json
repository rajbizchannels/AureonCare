    { "name": "Immunisation", "durationMinutes": 15, "color": "#14B8A6", "displayOrder": 30 },
    { "name": "Sick Visit", "durationMinutes": 20, "color": "#F59E0B", "displayOrder": 40 },
    { "name": "Development Review", "durationMinutes": 45, "color": "#8B5CF6", "displayOrder": 50 },
    { "name": "Follow-up", "durationMinutes": 15, "color": "#0EA5E9", "displayOrder": 60 }
  ],
  "serviceCategories": [
