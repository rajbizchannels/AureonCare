  "formTemplates": [
    {
      "slug": "audiology-intake",
      "name": "Audiology Intake",
      "templateType": "onboarding",
      "categorySlug": "onboarding",
      "version": "1.0",
      "languages": [
        "en"
      ],
      "complianceTags": [
        "HIPAA"
      ],
      "fields": [
        {
          "id": "main_concern",
          "type": "checkboxes",
          "label": "What brings you in?",
          "options": [
            "Hearing loss",
            "Ringing in the ears",
            "Dizziness",
            "Ear discharge",
            "Speech difficulty",
            "Hearing aid problem"
          ],
          "required": true
        },
        {
          "id": "side",
          "type": "radio",
          "label": "Which side?",
          "options": [
            "Left",
            "Right",
            "Both"
          ]
        },
        {
          "id": "onset",
          "type": "select",
          "label": "How did it come on?",
          "options": [
            "Gradually",
            "Suddenly",
            "Since birth",
            "After an illness or injury"
          ]
        },
        {
          "id": "noise_exposure",
          "type": "checkboxes",
          "label": "Noise exposure",
          "options": [
            "Loud workplace",
            "Firearms",
            "Music",
            "Machinery",
            "None"
          ]
        },
        {
          "id": "difficulty_situations",
          "type": "checkboxes",
          "label": "Where is hearing hardest?",
          "options": [
            "In groups",
            "On the phone",
            "Watching television",
            "In quiet one to one",
            "Background noise"
          ]
        },
        {
          "id": "current_aids",
          "type": "radio",
          "label": "Do you currently wear hearing aids?",
          "options": [
            "No",
            "One",
            "Both ears"
          ]
        },
        {
          "id": "tinnitus_impact",
          "type": "scale",
          "label": "If you have tinnitus, how much does it bother you, out of 10"
        },
        {
          "id": "ear_surgery",
          "type": "textarea",
          "label": "Previous ear surgery or infections"
        },
        {
          "id": "family_hearing",
          "type": "checkbox",
          "label": "Hearing loss in the family"
        }
      ]
    }
  ],
