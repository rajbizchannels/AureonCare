{
  "version": 2,
  "git": {
    "deploymentEnabled": {
      "marketing/linkedin-newsletter": false
    }
  },
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/platform(/.*)?",
      "dest": "backend/server.js"
    },
    {
      "src": "/health",
      "dest": "backend/server.js"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/.well-known/microsoft-identity-association.json",
      "dest": "backend/server.js"
    },
    {
      "src": "/book/(.*)",
      "dest": "frontend/index.html"
    },
    {
      "src": "/patient-login",
      "dest": "frontend/index.html"
    },
    {
      "src": "/signup(/complete)?",
      "dest": "frontend/index.html"
    },
    {
      "src": "/accept-invite",
      "dest": "frontend/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
