node_modules
frontend/build
/backend/uploads/medical-records

# Environment files — never commit secrets
backend/.env
frontend/.env

~$ER_MANUAL.docx
assets/aureoncare-logo.png
AureonCare_Executive_Presentation.pptx
AureonCare_Executive_Presentation1.pptx

# Google verification demo recording scratch output
docs/google-verification/out/

# Narration cache (regenerated on demand)
docs/demo/video-harness/.voice-cache/

# Rendered video output — distributed as downloads, not carried in the repo.
# Regenerate with docs/demo/video-harness/record.js. The .srt, .chapters.txt
# and .metadata.md beside them are text, diff cleanly, and stay tracked.
docs/demo/video-library/**/*.mp4
docs/demo/video-library/**/*.webm
docs/demo/video-library/**/*.thumbnail.png

# The marketing cuts are the exception: they are the deliverable itself, shared
# by link and re-cut rarely, so they are carried in the repo. Vercel skips the
# whole docs/ tree (see .vercelignore), so their weight never reaches a build.
!docs/demo/video-library/marketing/*.mp4
!docs/demo/video-library/marketing/*.thumbnail.png

# Screenshot and DOM dump written when a recording step fails. Useful while
# fixing a stale selector, worthless once it is fixed.
docs/demo/video-library/**/_debug/

# probe.js records through the same harness, so a selector hunt drops a cut
# named after the probe spec into whichever library folder it targeted.
docs/demo/video-library/**/probe*

# Root-level env file (e.g. from `vercel env pull`) — never commit
.env
.env.*
!.env.example
.vercel
.env*
mobile/package.json
package-lock.json
package.json
mobile/package.json
mobile/package.json
package-lock.json
package.json
