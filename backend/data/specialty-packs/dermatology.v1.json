          "options": [
            "Minimal",
            "Moderate",
            "Heavy",
            "Sunbed use"
          ]
        },
        {
          "id": "skin_cancer_history",
          "type": "checkbox",
          "label": "Have you had a skin cancer before?"
        },
        {
          "id": "family_melanoma",
          "type": "checkbox",
          "label": "Melanoma in a close relative"
        },
        {
          "id": "treatments_tried",
          "type": "textarea",
          "label": "Creams or treatments already tried"
        },
        {
          "id": "medications",
