  "formTemplates": [
    {
      "slug": "respiratory-intake",
      "name": "Respiratory Intake",
      "templateType": "onboarding",
      "categorySlug": "onboarding",
      "version": "1.0",
      "languages": [
        "en"
      ],
      "complianceTags": [
        "HIPAA"
      ],
      "fields": [
        {
          "id": "main_symptom",
          "type": "checkboxes",
          "label": "What brings you in?",
          "options": [
            "Breathlessness",
            "Cough",
            "Wheeze",
            "Chest tightness",
            "Coughing blood",
            "Snoring or daytime sleepiness"
          ],
          "required": true
        },
        {
          "id": "duration",
          "type": "text",
          "label": "How long has this been going on?"
        },
        {
          "id": "breathless_when",
          "type": "select",
          "label": "When are you breathless?",
          "options": [
            "Not breathless",
            "Hurrying or uphill",
            "Walking on the flat",
            "After 100 metres",
            "Dressing or at rest"
          ]
        },
        {
          "id": "smoking",
          "type": "radio",
          "label": "Smoking",
          "options": [
            "Never smoked",
            "Ex-smoker",
            "Current smoker"
          ]
        },
        {
          "id": "pack_years",
          "type": "text",
          "label": "If you have smoked, roughly how much and for how long?"
        },
        {
          "id": "occupational_exposure",
          "type": "textarea",
          "label": "Any dust, fumes or asbestos exposure at work"
        },
        {
          "id": "inhalers",
          "type": "textarea",
          "label": "Inhalers you use, and how often"
        },
        {
          "id": "admissions",
          "type": "text",
          "label": "Hospital admissions for breathing problems in the last year"
        },
        {
          "id": "epworth",
          "type": "scale",
          "label": "How likely are you to doze off during the day, out of 10?"
        }
      ]
    }
  ],
