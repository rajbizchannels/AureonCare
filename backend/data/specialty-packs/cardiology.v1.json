  "formTemplates": [
    {
      "slug": "cardiology-intake",
      "name": "Cardiology Intake",
      "templateType": "onboarding",
      "categorySlug": "onboarding",
      "version": "1.0",
      "languages": [
        "en"
      ],
      "complianceTags": [
        "HIPAA"
      ],
      "fields": [
        {
          "id": "presenting_symptom",
          "type": "checkboxes",
          "label": "What brings you in?",
          "options": [
            "Chest pain",
            "Breathlessness",
            "Palpitations",
            "Blackouts",
            "Swollen ankles",
            "Abnormal ECG",
            "Referred for an opinion"
          ],
          "required": true
        },
        {
          "id": "symptom_detail",
          "type": "textarea",
          "label": "Describe the symptoms in your own words",
          "required": true
        },
        {
          "id": "exertion",
          "type": "select",
          "label": "How much activity brings it on?",
          "options": [
            "No limit",
            "Climbing stairs",
            "Walking on the flat",
            "Minimal activity",
            "At rest"
          ]
        },
        {
          "id": "cardiac_history",
          "type": "checkboxes",
          "label": "Have you had any of these?",
          "options": [
            "Heart attack",
            "Angina",
            "Stent or angioplasty",
            "Bypass surgery",
            "Atrial fibrillation",
            "Heart failure",
            "Pacemaker or ICD",
            "Valve problem"
          ]
        },
        {
          "id": "risk_factors",
          "type": "checkboxes",
          "label": "Do any of these apply?",
          "options": [
            "High blood pressure",
            "High cholesterol",
            "Diabetes",
            "Smoker",
            "Ex-smoker",
            "Family history of heart disease"
          ]
        },
        {
          "id": "medications",
          "type": "textarea",
          "label": "Current medicines, with doses",
          "required": true
        },
        {
          "id": "allergies",
          "type": "textarea",
          "label": "Allergies"
        },
        {
          "id": "family_sudden_death",
          "type": "checkbox",
          "label": "Has anyone in your family died suddenly before the age of 50?"
        }
      ]
    }
  ],
