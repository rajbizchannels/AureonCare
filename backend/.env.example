# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Public URL of the backend (used for OAuth redirect URIs)
AC_BE_URL=https://your-vercel-backend.vercel.app
# Deployed frontend URL (used for CORS)
AC_FE_URL=https://your-vercel-frontend.vercel.app

# ─── Supabase ────────────────────────────────────────────────────────────────
# Supabase dashboard → Settings → API
AC_SB_URL=https://your-project-ref.supabase.co
# Publishable key — safe to use in client-side code
AC_SB_PK=your-supabase-publishable-key
# Secret key — server-side only, never expose to the browser
AC_SB_SK=your-supabase-secret-key

# ─── Database (PostgreSQL via Supabase) ──────────────────────────────────────
# Supabase dashboard → Settings → Database → Connection string → URI
# Use the "Transaction Pooler" (port 6543) for Vercel serverless deployments.
AC_PG_URI=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# Individual vars — only used when AC_PG_URI is absent (local dev)
AC_DB_H=localhost
AC_DB_P=5432
AC_DB_N=aureoncare
AC_DB_U=postgres
AC_DB_W=your-local-db-password
# Set to "true" when connecting to Supabase without AC_PG_URI
AC_DB_S=false

# ─── Security ────────────────────────────────────────────────────────────────
AC_TK_S=your-super-secret-jwt-key-min-32-chars
AC_TK_E=24h
AC_EK=your-32-byte-encryption-key-here

# Secure-messaging body encryption (AES-256-GCM). 32 bytes, hex or base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Falls back to a key derived from AC_TK_S when unset, which is fine for local
# development — but set it explicitly in production: rotating AC_TK_S would
# otherwise make every stored message permanently unreadable.
AC_MSG_KEY=your-32-byte-message-encryption-key

# ─── Redis (optional) ────────────────────────────────────────────────────────
AC_USE_RD=false
AC_RD_H=localhost
AC_RD_P=6379
# AC_RD_W=your-redis-password

# ─── Email ────────────────────────────────────────────────────────────────────
# AC_SG_KEY=your-sendgrid-key
# AC_FROM_EM=noreply@aureoncare.tech
# AC_SM_H=smtp.gmail.com
# AC_SM_P=587
# AC_SM_U=your-email@gmail.com
# AC_SM_W=your-app-password
AC_CLN=AureonCare Clinic

# ─── File uploads ─────────────────────────────────────────────────────────────
# On Vercel, use /tmp for transient uploads; persist to Supabase Storage.
AC_UPL_DIR=/tmp/aureoncare/uploads
AC_UPL_MAX=10485760

# ─── Logging ─────────────────────────────────────────────────────────────────
AC_LOG_DIR=/tmp/aureoncare/logs
AC_LOG_LVL=info

# ─── Zoom OAuth ──────────────────────────────────────────────────────────────
AC_ZM_CID=your-zoom-client-id
AC_ZM_CSK=your-zoom-client-secret

# ─── Google Meet OAuth ───────────────────────────────────────────────────────
# AC_GM_CID=your-google-meet-client-id
# AC_GM_CSK=your-google-meet-client-secret

# ─── Microsoft Teams / Azure AD ──────────────────────────────────────────────
# AC_MS_CID=your-azure-client-id
# AC_MS_CSK=your-azure-client-secret

# ─── Cisco Webex ─────────────────────────────────────────────────────────────
# AC_WBX_CID=your-webex-client-id
# AC_WBX_CSK=your-webex-client-secret

# ─── Google Calendar Sync (patient portal) ───────────────────────────────────
# Lets patients connect their own Google Calendar so appointments sync to it.
# Google Cloud console → APIs & Services:
#   1. Enable the Google Calendar API.
#   2. Create (or reuse) an OAuth 2.0 Web application client.
#   3. Add this Authorised redirect URI to that client:
#        {AC_BE_URL}/api/calendar-sync/callback
# Scopes requested: calendar.events, calendar.readonly,
#                   userinfo.profile, userinfo.email
# Leave unset to disable the feature — the portal then shows "not set up yet"
# and /api/calendar-sync returns 503 instead of failing at request time.
# AC_GG_CID=your-google-oauth-client-id
# AC_GG_CSK=your-google-oauth-client-secret
# Optional — defaults to {AC_BE_URL}/api/calendar-sync/callback
# AC_GG_URI=https://your-backend/api/calendar-sync/callback
# The OAuth callback redirects the patient back to AC_FE_URL (see Application).

# ─── Google Drive Backup OAuth ───────────────────────────────────────────────
# Reuses the same Google OAuth client as the frontend (REACT_APP_GG_CID).
# Enable the Google Drive API and add this redirect URI to your Google Cloud
# OAuth client:  {AC_BE_URL}/api/integrations/oauth/google_drive/callback
# Required scopes: https://www.googleapis.com/auth/drive.file
#                  https://www.googleapis.com/auth/drive.appdata (optional)
REACT_APP_GG_CID=your-google-oauth-client-id   # shared with frontend
# AC_GD_CSK=your-google-oauth-client-secret     # backend-only secret

# ─── OneDrive Backup OAuth ───────────────────────────────────────────────────
# Reuses the same Azure AD app as the frontend (REACT_APP_MS_CID).
# Add this redirect URI in Azure Portal → App registrations → your app:
#   {AC_BE_URL}/api/integrations/oauth/onedrive/callback
# API permissions (Microsoft Graph): Files.ReadWrite, offline_access
REACT_APP_MS_CID=your-microsoft-oauth-client-id   # shared with frontend
# AC_OD_CSK=your-azure-app-client-secret           # backend-only secret

# ─── Stripe (Platform-level keys) ────────────────────────────────────────────
# These are the PLATFORM'S Stripe keys — only needed when subscribers are
# expected to process payments through the platform Stripe account.
# Subscribers who use their OWN Stripe account enter keys in the Admin Panel
# (Admin → Integrations → Payment Processing) instead of here.
#
# Get these from: https://dashboard.stripe.com/apikeys
#
# Secret key — server-side only, NEVER expose to the browser
AC_STRIPE_SK=sk_live_...
# Publishable key — safe to pass to frontend (used when platform integration is active)
AC_STRIPE_PK=pk_live_...
# Webhook signing secret — from Stripe Dashboard → Webhooks → your endpoint
# Webhook endpoint to register in Stripe: {AC_BE_URL}/api/stripe-webhook
# Events to enable: payment_intent.succeeded, payment_intent.payment_failed,
#                   checkout.session.completed, charge.refunded, charge.dispute.created
AC_STRIPE_WHS=whsec_...
