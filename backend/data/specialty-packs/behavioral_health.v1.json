  "formTemplates": [
    {
      "slug": "phq9-depression-screening",
      "name": "PHQ-9 Depression Screening",
      "description": "Standard Patient Health Questionnaire-9 for depression screening and severity assessment.",
      "templateType": "clinical",
      "categorySlug": "behavioral_health",
      "version": "1.0",
      "subcategory": "Depression Screening",
      "languages": [
        "en",
        "es"
      ],
      "tags": [
        "PHQ-9",
        "depression",
        "mental health",
        "screening"
      ],
      "complianceTags": [
        "HIPAA"
      ],
      "fields": [
        {
          "id": "patient_name",
          "type": "text",
          "label": "Patient Name",
          "required": true
        },
        {
          "id": "visit_date",
          "type": "date",
          "label": "Date",
          "required": true
        },
        {
          "id": "paragraph_intro",
          "type": "paragraph",
          "label": "Over the last 2 weeks, how often have you been bothered by any of the following problems? (0=Not at all, 1=Several days, 2=More than half the days, 3=Nearly every day)"
        },
        {
          "id": "phq1",
          "type": "select",
          "label": "1. Little interest or pleasure in doing things",
          "required": true,
          "options": [
            "0 – Not at all",
            "1 – Several days",
            "2 – More than half the days",
            "3 – Nearly every day"
          ]
        },
        {
          "id": "phq2",
          "type": "select",
          "label": "2. Feeling down, depressed, or hopeless",
          "required": true,
          "options": [
            "0 – Not at all",
            "1 – Several days",
            "2 – More than half the days",
            "3 – Nearly every day"
          ]
        },
        {
          "id": "phq3",
          "type": "select",
          "label": "3. Trouble falling or staying asleep, or sleeping too much",
          "required": true,
          "options": [
            "0 – Not at all",
            "1 – Several days",
            "2 – More than half the days",
            "3 – Nearly every day"
          ]
        },
        {
          "id": "phq4",
          "type": "select",
          "label": "4. Feeling tired or having little energy",
          "required": true,
          "options": [
            "0 – Not at all",
            "1 – Several days",
            "2 – More than half the days",
            "3 – Nearly every day"
          ]
        },
        {
          "id": "phq5",
          "type": "select",
          "label": "5. Poor appetite or overeating",
          "required": true,
          "options": [
            "0 – Not at all",
            "1 – Several days",
            "2 – More than half the days",
            "3 – Nearly every day"
          ]
        },
        {
          "id": "phq6",
          "type": "select",
          "label": "6. Feeling bad about yourself – or that you are a failure",
          "required": true,
          "options": [
            "0 – Not at all",
            "1 – Several days",
            "2 – More than half the days",
            "3 – Nearly every day"
          ]
        },
        {
          "id": "phq7",
          "type": "select",
          "label": "7. Trouble concentrating on things",
          "required": true,
          "options": [
            "0 – Not at all",
            "1 – Several days",
            "2 – More than half the days",
            "3 – Nearly every day"
          ]
        },
        {
          "id": "phq8",
          "type": "select",
          "label": "8. Moving or speaking so slowly that other people could have noticed",
          "required": true,
          "options": [
            "0 – Not at all",
            "1 – Several days",
            "2 – More than half the days",
            "3 – Nearly every day"
          ]
        },
        {
          "id": "phq9",
          "type": "select",
          "label": "9. Thoughts that you would be better off dead or of hurting yourself",
          "required": true,
          "options": [
            "0 – Not at all",
            "1 – Several days",
            "2 – More than half the days",
            "3 – Nearly every day"
          ]
        },
        {
          "id": "phq_difficulty",
          "type": "select",
          "label": "How difficult have these problems made it for you at work, home, or with other people?",
          "required": false,
          "options": [
            "Not difficult at all",
            "Somewhat difficult",
            "Very difficult",
            "Extremely difficult"
          ]
        }
      ]
    },
