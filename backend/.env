# Application
NODE_ENV=development
PORT=3000
AC_API_SVC=http://localhost:3000
AC_FE_URL=http://localhost:3001

# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL  → Supabase dashboard → Settings → API → Project URL
AC_SB_URL=https://your-project-ref.supabase.co

# Publishable key (safe to expose in client)  → Settings → API → Project API keys
AC_SB_PK=your-supabase-publishable-key

# Secret key (server-side ONLY — never expose to browser) → Settings → API → Project API keys
AC_SB_SK=your-supabase-secret-key

# ─── Database (PostgreSQL via Supabase) ──────────────────────────────────────
# Use the Supabase "Transaction Pooler" connection string for Vercel serverless.
# Supabase dashboard → Settings → Database → Connection string → URI (Transaction mode)
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
AC_PG_URI=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# Individual vars (used as fallback when AC_PG_URI is not set — e.g. local dev)
AC_DB_H=localhost
AC_DB_P=5432
AC_DB_N=aureoncare
AC_DB_U=postgres
AC_DB_W=MedFlow2024!
# Set to "true" to enable SSL for individual-var connections (required for Supabase)
AC_DB_S=false

# Redis
AC_USE_RD=false
AC_RD_H=localhost
AC_RD_P=6379
# AC_RD_W=AureonCareRedis2024!

# Security
AC_TK_S=your-super-secret-jwt-key-change-this-in-production-min-32-chars
AC_TK_E=24h
AC_EK=your-32-byte-encryption-key-here-change-in-prod

# Email (configure if you have SendGrid account)
# AC_SG_KEY=your-sendgrid-key
# AC_FROM_EM=noreply@aureoncare.com
#AC_SM_H=smtp.gmail.com
#AC_SM_P=587
#AC_SM_U=rajbizchannels@gmail.com
#AC_SM_W=*Smbz786#
AC_CLN=AureonCare Clinic
AC_FE_URL=http://localhost:3001

# File uploads
AC_UPL_DIR=C:\\AureonCare\\uploads
AC_UPL_MAX=10485760

# Logging
AC_LOG_DIR=C:\\AureonCare\\logs
AC_LOG_LVL=debug

# Zoom OAuth Integration
# Get from: https://marketplace.zoom.us → Develop → Build App → General App
# Set Redirect URL in Zoom to: {AC_BE_URL}/api/integrations/oauth/zoom/callback
AC_ZM_CID=XTrkxHTqSqWj88A9QoD9pw
AC_ZM_CSK=XVSs4HxIZ2dLjfrUh3YXqJEKvV9Ntbbw

# Zoom Meeting SDK Credentials (optional)
# For a General App, Client ID == SDK Key and Client Secret == SDK Secret.
# Leave blank — the server automatically uses AC_ZM_CID/SECRET above.
# Only set these if you are using a separate dedicated Meeting SDK app.
# AC_ZM_SDK_K=
# AC_ZM_SDK_S=

# Google Meet — https://console.cloud.google.com/apis/credentials → OAuth 2.0 Client
# GOOGLE_MEET_CLIENT_ID=
# GOOGLE_MEET_CLIENT_SECRET=

# Cisco Webex — https://developer.webex.com/my-apps → Integration
# WEBEX_CLIENT_ID=
# WEBEX_CLIENT_SECRET=

# OAuth base URL (used to build redirect URIs — must point to the backend)
AC_BE_URL=http://localhost:3000
