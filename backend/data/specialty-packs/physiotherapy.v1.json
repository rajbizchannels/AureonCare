  "formTemplates": [
    {
      "slug": "physiotherapy-assessment",
      "name": "Physiotherapy Assessment",
      "templateType": "onboarding",
      "categorySlug": "onboarding",
      "version": "1.0",
      "languages": [
        "en"
      ],
      "complianceTags": [
        "HIPAA"
      ],
      "fields": [
        {
          "id": "problem_area",
          "type": "select",
          "label": "Main area of difficulty",
          "options": [
            "Neck",
            "Shoulder",
            "Elbow",
            "Wrist or hand",
            "Back",
            "Hip",
            "Knee",
            "Ankle or foot",
            "Balance",
            "General weakness"
          ],
          "required": true
        },
        {
          "id": "how_started",
          "type": "textarea",
          "label": "How did it start?",
          "required": true
        },
        {
          "id": "duration",
          "type": "text",
          "label": "How long have you had it?"
        },
        {
          "id": "pain_now",
          "type": "scale",
          "label": "Pain right now, out of 10"
        },
        {
          "id": "pain_worst",
          "type": "scale",
          "label": "Pain at its worst, out of 10"
        },
        {
          "id": "aggravating",
          "type": "textarea",
          "label": "What makes it worse?"
        },
        {
          "id": "easing",
          "type": "textarea",
          "label": "What makes it better?"
        },
        {
          "id": "function_limits",
          "type": "checkboxes",
          "label": "What is it stopping you doing?",
          "options": [
            "Work",
            "Sleep",
            "Driving",
            "Sport",
            "Housework",
            "Walking",
            "Lifting",
            "Nothing in particular"
          ]
        },
        {
          "id": "previous_physio",
          "type": "textarea",
          "label": "Previous physiotherapy for this, and whether it helped"
        },
        {
          "id": "goals",
          "type": "textarea",
          "label": "What do you want to be able to do again?",
          "required": true
        }
      ]
    }
  ],
