      "name": "Egg Collection",
      "categoryName": "Treatment",
      "durationMinutes": 60,
      "consentFormRequired": true,
      "requiresPreparation": true,
      "preparationInstructions": "Nothing to eat for six hours and nothing to drink for two hours beforehand. Arrange for someone to take you home; you must not drive for 24 hours."
    },
    {
      "name": "Embryo Transfer",
      "categoryName": "Treatment",
      "durationMinutes": 45,
      "consentFormRequired": true,
      "requiresPreparation": true,
      "preparationInstructions": "Arrive with a comfortably full bladder, which makes the transfer easier to guide."
