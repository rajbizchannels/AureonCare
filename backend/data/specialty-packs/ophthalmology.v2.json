  "formTemplates": [
    {
      "slug": "ophthalmology-intake",
      "name": "Eye Clinic Intake",
      "templateType": "onboarding",
      "fields": [
        {
          "id": "presenting_complaint",
          "type": "textarea",
          "label": "What is the problem with your eyes?",
          "required": true
        },
        {
          "id": "affected_eye",
          "type": "radio",
          "label": "Which eye?",
          "options": [
            "Right",
            "Left",
            "Both"
          ],
          "required": true
        },
        {
          "id": "duration",
          "type": "text",
          "label": "How long has it been going on?"
        },
        {
          "id": "wears_glasses",
          "type": "radio",
          "label": "Do you wear glasses or contact lenses?",
          "options": [
            "Neither",
            "Glasses",
            "Contact lenses",
            "Both"
          ]
        },
        {
          "id": "eye_surgery_history",
          "type": "textarea",
          "label": "Any previous eye surgery or injury?"
        },
        {
          "id": "family_glaucoma",
          "type": "checkbox",
          "label": "Does anyone in your family have glaucoma?"
        },
        {
          "id": "diabetes",
          "type": "checkbox",
          "label": "Do you have diabetes?"
        },
        {
          "id": "current_eye_drops",
          "type": "textarea",
          "label": "Eye drops you are currently using"
        }
      ]
    },
    {
      "slug": "ophthalmology-surgical-consent",
      "name": "Consent to Eye Surgery",
      "templateType": "consent",
      "requireSignature": true,
      "fields": [
        {
          "id": "procedure",
          "type": "text",
          "label": "Procedure",
          "required": true
        },
        {
          "id": "operative_eye",
          "type": "radio",
          "label": "Eye to be operated on",
          "options": [
            "Right",
            "Left"
          ],
          "required": true
        },
        {
          "id": "eye_confirmed_with_patient",
          "type": "checkbox",
          "label": "The eye has been confirmed with the patient and marked",
          "required": true
        },
        {
          "id": "risks_explained",
          "type": "checkbox",
          "label": "The risks have been explained, including infection, bleeding, raised pressure, retinal detachment and loss of vision",
          "required": true
        },
        {
          "id": "lens_choice_discussed",
          "type": "checkbox",
          "label": "Lens options and the expected refractive outcome have been discussed"
        },
        {
          "id": "questions_answered",
          "type": "checkbox",
          "label": "I have had the chance to ask questions and they were answered",
          "required": true
        }
      ]
    },
    {
      "slug": "ophthalmology-injection-record",
      "name": "Intravitreal Injection Record",
      "templateType": "clinical",
      "fields": [
        {
          "id": "drug",
          "type": "text",
          "label": "Agent injected",
          "required": true
        },
        {
          "id": "eye",
          "type": "radio",
          "label": "Eye",
          "options": [
            "Right",
            "Left"
          ],
          "required": true
        },
        {
          "id": "batch_number",
          "type": "text",
          "label": "Batch number"
        },
        {
          "id": "injection_number",
          "type": "number",
          "label": "Injection number in this series"
        },
        {
          "id": "complications",
          "type": "textarea",
          "label": "Complications"
        },
        {
          "id": "next_due",
          "type": "date",
          "label": "Next injection due"
        }
      ]
    }
  ],
