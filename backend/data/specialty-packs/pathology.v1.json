      "slug": "laboratory-request",
      "name": "Laboratory Request and Consent",
      "templateType": "clinical",
      "categorySlug": "clinical",
      "version": "1.0",
      "languages": [
        "en"
      ],
      "complianceTags": [
        "HIPAA"
