# Application
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# Database
#DATABASE_URL=postgresql://postgres:AureonCare2024SecurePass!@localhost:5432/aureoncare
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aureoncare
DB_USER=postgres
DB_PASSWORD=MedFlow2024!

# Redis
USE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=AureonCareRedis2024!

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRATION=24h
ENCRYPTION_KEY=your-32-byte-encryption-key-here-change-in-prod

# Email (configure if you have SendGrid account)
# SENDGRID_API_KEY=your-sendgrid-key
# FROM_EMAIL=noreply@aureoncare.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=rajbizchannels@gmail.com
SMTP_PASS=*Smbz786#
CLINIC_NAME=AureonCare Clinic
FRONTEND_URL=http://localhost:3001

# File uploads
UPLOAD_DIR=C:\\AureonCare\\uploads
MAX_FILE_SIZE=10485760

# Logging
LOG_DIR=C:\\AureonCare\\logs
LOG_LEVEL=debug

# ─── Telehealth Provider Credentials (platform-level, SaaS) ───
# Set these once per platform. Clinic admins never see or enter these —
# they simply click "Connect Account" and authenticate via OAuth.

# Zoom — https://marketplace.zoom.us → General App → App Credentials
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# For a General App, Client ID == SDK Key. Only set these if using a separate SDK app:
# ZOOM_SDK_KEY=
# ZOOM_SDK_SECRET=

# Google Meet — https://console.cloud.google.com/apis/credentials → OAuth 2.0 Client
# GOOGLE_MEET_CLIENT_ID=
# GOOGLE_MEET_CLIENT_SECRET=

# Cisco Webex — https://developer.webex.com/my-apps → Integration
# WEBEX_CLIENT_ID=
# WEBEX_CLIENT_SECRET=

# OAuth base URL (used to build redirect URIs — must point to the backend)
APP_BASE_URL=http://localhost:3000