      "fields": [
        {
          "id": "concern",
          "type": "textarea",
          "label": "What would you like to discuss?",
          "required": true
        },
        {
          "id": "area",
          "type": "text",
          "label": "Which part of the body?",
          "required": true
        },
        {
          "id": "duration",
          "type": "text",
          "label": "How long has it been a problem?"
        },
        {
          "id": "functional_impact",
          "type": "textarea",
          "label": "How does it affect what you can do day to day?"
        },
        {
          "id": "previous_surgery_area",
          "type": "textarea",
          "label": "Previous surgery or injury to this area"
        },
        {
          "id": "healing_problems",
          "type": "checkboxes",
          "label": "Have you ever had any of these?",
          "options": [
            "Thick or raised scars",
            "Keloid scars",
            "Wound infection",
            "Slow healing",
            "None of these"
          ]
        },
        {
          "id": "smoking",
          "type": "radio",
          "label": "Smoking",
          "options": [
            "Never",
            "Ex-smoker",
            "Current smoker"
          ],
          "required": true
        },
        {
          "id": "diabetes",
          "type": "checkbox",
          "label": "Do you have diabetes?"
        },
        {
          "id": "medications",
          "type": "textarea",
          "label": "Current medicines, including blood thinners",
          "required": true
        },
        {
          "id": "expectations",
          "type": "textarea",
          "label": "What are you hoping for from treatment?"
        }
      ]
    }
