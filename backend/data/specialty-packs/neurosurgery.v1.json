      "fields": [
        {
          "id": "referral_reason",
          "type": "textarea",
          "label": "Reason for referral",
          "required": true
        },
        {
          "id": "symptom_area",
          "type": "checkboxes",
          "label": "Where are the symptoms?",
          "options": [
            "Head",
            "Neck",
            "Arm",
            "Back",
            "Leg"
          ],
          "required": true
        },
        {
          "id": "pain_vs_weakness",
          "type": "checkboxes",
          "label": "What are you experiencing?",
          "options": [
            "Pain",
            "Numbness",
            "Pins and needles",
            "Weakness",
            "Loss of balance",
            "Bladder or bowel changes"
          ]
        },
        {
          "id": "red_flags",
          "type": "checkboxes",
          "label": "Any of these?",
          "options": [
            "Loss of bladder control",
            "Loss of bowel control",
            "Numbness between the legs",
            "Rapidly worsening weakness",
            "None of these"
          ],
          "required": true
        },
        {
          "id": "onset",
          "type": "text",
          "label": "When did it start?"
        },
        {
          "id": "imaging",
          "type": "textarea",
          "label": "Scans already done, where and when"
        },
        {
          "id": "previous_spine_surgery",
          "type": "textarea",
          "label": "Previous spine or brain surgery"
        },
        {
          "id": "medications",
          "type": "textarea",
          "label": "Current medicines, including blood thinners",
          "required": true
        },
        {
          "id": "walking_aid",
          "type": "radio",
          "label": "Do you use a walking aid?",
          "options": [
            "No",
            "Stick",
            "Frame",
            "Wheelchair"
          ]
        }
      ]
    }
