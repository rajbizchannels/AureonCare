        },
        {
          "id": "dental_status",
          "type": "radio",
          "label": "Have you had a recent dental check?",
          "options": [
            "Yes",
            "No"
          ],
          "required": true
        },
        {
          "id": "smoking",
          "type": "radio",
          "label": "Smoking",
          "options": [
            "Never",
            "Ex-smoker",
            "Current smoker"
          ],
          "required": true
        },
        {
          "id": "anticoagulants",
          "type": "textarea",
          "label": "Blood thinners and antiplatelets, with the last dose taken",
