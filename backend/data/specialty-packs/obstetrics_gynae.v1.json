  "formTemplates": [
    {
      "slug": "obgyn-intake",
      "name": "Obstetrics and Gynaecology Intake",
      "templateType": "onboarding",
      "categorySlug": "onboarding",
      "version": "1.0",
      "languages": [
        "en"
      ],
      "complianceTags": [
        "HIPAA"
      ],
      "fields": [
        {
          "id": "reason",
          "type": "textarea",
          "label": "Reason for today’s visit",
          "required": true
        },
        {
          "id": "pregnant_now",
          "type": "radio",
          "label": "Are you pregnant?",
          "options": [
            "No",
            "Yes",
            "Not sure"
          ],
          "required": true
        },
        {
          "id": "lmp",
          "type": "date",
          "label": "First day of your last period"
        },
        {
          "id": "cycle",
          "type": "text",
          "label": "Usual cycle — how often, how long, how heavy"
        },
        {
          "id": "pregnancies",
          "type": "text",
          "label": "Number of pregnancies and births"
        },
        {
          "id": "delivery_history",
          "type": "textarea",
          "label": "How previous births went, including any complications"
        },
        {
          "id": "contraception",
          "type": "select",
          "label": "Current contraception",
          "options": [
            "None",
            "Pill",
            "Implant",
            "Coil",
            "Injection",
            "Barrier",
            "Sterilised",
            "Other"
          ]
        },
        {
          "id": "last_smear",
          "type": "text",
          "label": "Date and result of your last cervical screening"
        },
        {
          "id": "gynae_surgery",
          "type": "textarea",
          "label": "Previous gynaecological surgery"
        },
        {
          "id": "medications",
          "type": "textarea",
          "label": "Current medicines"
        }
      ]
    }
  ],
