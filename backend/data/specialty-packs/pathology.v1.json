        {
          "id": "clinical_details",
          "type": "textarea",
          "label": "Clinical details and reason for testing",
          "required": true
        },
        {
          "id": "fasting",
          "type": "radio",
          "label": "Has the patient fasted?",
          "options": [
            "Yes",
            "No",
            "Not required"
          ],
          "required": true
        },
        {
          "id": "last_meal",
          "type": "text",
          "label": "Time of last food or drink other than water"
        },
        {
          "id": "anticoagulants",
          "type": "radio",
          "label": "Is the patient on a blood thinner?",
          "options": [
            "No",
            "Yes"
          ],
          "required": true
        },
        {
          "id": "difficult_veins",
          "type": "checkbox",
          "label": "Known difficult venous access"
        },
        {
          "id": "needle_anxiety",
          "type": "checkbox",
          "label": "History of fainting or needle anxiety"
        },
        {
          "id": "specimen_site",
          "type": "text",
          "label": "For a tissue specimen, the site and side"
        },
        {
          "id": "urgent",
          "type": "radio",
          "label": "Urgency",
          "options": [
            "Routine",
            "Urgent",
            "Same day"
          ]
        }
