          "label": "Treatment so far, including surgery, chemotherapy and radiotherapy"
        },
        {
          "id": "current_symptoms",
          "type": "checkboxes",
          "label": "How are you feeling at the moment?",
          "options": [
            "Pain",
            "Tiredness",
            "Nausea",
            "Poor appetite",
            "Weight loss",
            "Breathlessness",
            "Low mood",
            "Numbness or tingling"
          ]
        },
        {
          "id": "performance_status",
          "type": "select",
          "label": "How are you managing day to day?",
          "options": [
            "Fully active",
            "Light activity only",
            "Up and about more than half the day",
            "In bed or a chair more than half the day",
            "Completely dependent"
          ]
        },
        {
          "id": "medications",
          "type": "textarea",
          "label": "Current medicines, with doses",
          "required": true
        },
        {
          "id": "allergies",
          "type": "textarea",
          "label": "Allergies and reactions"
        },
        {
          "id": "support",
          "type": "textarea",
          "label": "Who is supporting you at home?"
        },
        {
          "id": "questions",
          "type": "textarea",
          "label": "Anything you want to be sure we cover today"
        }
