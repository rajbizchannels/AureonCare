  "formTemplates": [
    {
      "slug": "dietetic-assessment",
      "name": "Dietetic Assessment",
      "templateType": "onboarding",
      "categorySlug": "onboarding",
      "version": "1.0",
      "languages": [
        "en"
      ],
      "complianceTags": [
        "HIPAA"
      ],
      "fields": [
        {
          "id": "referral_reason",
          "type": "textarea",
          "label": "Reason for referral",
          "required": true
        },
        {
          "id": "weight_history",
          "type": "textarea",
          "label": "Weight history, and any recent change"
        },
        {
          "id": "typical_day",
          "type": "textarea",
          "label": "What you eat and drink on a typical day",
          "required": true
        },
        {
          "id": "restrictions",
          "type": "checkboxes",
          "label": "Dietary restrictions",
          "options": [
            "Vegetarian",
            "Vegan",
            "Halal",
            "Kosher",
            "Gluten free",
            "Dairy free",
            "Nut free",
            "Other"
          ]
        },
        {
          "id": "allergies",
          "type": "textarea",
          "label": "Food allergies and intolerances"
        },
        {
          "id": "appetite",
          "type": "select",
          "label": "Appetite",
          "options": [
            "Good",
            "Reduced",
            "Poor",
            "Increased"
          ]
        },
        {
          "id": "gi_symptoms",
          "type": "checkboxes",
          "label": "Any of these?",
          "options": [
            "Nausea",
            "Vomiting",
            "Constipation",
            "Diarrhoea",
            "Reflux",
            "Bloating",
            "Difficulty swallowing"
          ]
        },
        {
          "id": "supplements",
          "type": "textarea",
          "label": "Supplements you take"
        },
        {
          "id": "activity",
          "type": "text",
          "label": "Physical activity in a typical week"
        },
        {
          "id": "goals",
          "type": "textarea",
          "label": "What you would like to get out of this"
        }
      ]
    }
  ],
