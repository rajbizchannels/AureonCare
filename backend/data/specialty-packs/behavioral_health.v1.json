      "fields": [
        {
          "id": "patient_name",
          "type": "text",
          "label": "Patient Name",
          "required": true
        },
        {
          "id": "dob",
          "type": "date",
          "label": "Date of Birth",
          "required": true
        },
        {
          "id": "heading_presenting",
          "type": "heading",
          "label": "Presenting Concerns"
