          "options": [
            "Normal",
            "Slow",
            "Very slow",
            "Stop-start",
            "Needing to strain"
          ]
        },
        {
          "id": "leakage",
          "type": "select",
          "label": "Leaking",
          "options": [
            "None",
            "On coughing or exercise",
            "With sudden urgency",
            "Both",
            "Continuous"
          ]
        },
        {
          "id": "blood",
          "type": "checkbox",
          "label": "Have you ever seen blood in your urine?"
        },
        {
          "id": "stone_history",
          "type": "textarea",
          "label": "Previous stones, and how they were treated"
        },
        {
          "id": "previous_surgery",
