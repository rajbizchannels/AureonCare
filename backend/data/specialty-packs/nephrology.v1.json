  "formTemplates": [
    {
      "slug": "nephrology-intake",
      "name": "Nephrology Intake",
      "templateType": "onboarding",
      "categorySlug": "onboarding",
      "version": "1.0",
      "languages": [
        "en"
      ],
      "complianceTags": [
        "HIPAA"
      ],
      "fields": [
        {
          "id": "referral_reason",
          "type": "textarea",
          "label": "Reason for referral",
          "required": true
        },
        {
          "id": "known_kidney_disease",
          "type": "radio",
          "label": "Have you been told you have kidney disease?",
          "options": [
            "No",
            "Yes",
            "Not sure"
          ]
        },
        {
          "id": "urine_changes",
          "type": "checkboxes",
          "label": "Any of these?",
          "options": [
            "Frothy urine",
            "Blood in urine",
            "Passing less urine",
            "Passing more at night",
            "Swollen ankles or face"
          ]
        },
        {
          "id": "bp_history",
          "type": "text",
          "label": "How long have you had high blood pressure, if at all?"
        },
        {
          "id": "diabetes",
          "type": "radio",
          "label": "Do you have diabetes?",
          "options": [
            "No",
            "Type 1",
            "Type 2"
          ]
        },
        {
          "id": "nsaids",
          "type": "radio",
          "label": "Do you take anti-inflammatory painkillers?",
          "options": [
            "No",
            "Occasionally",
            "Regularly"
          ]
        },
        {
          "id": "medications",
          "type": "textarea",
          "label": "Current medicines, with doses",
          "required": true
        },
        {
          "id": "family_kidney",
          "type": "checkbox",
          "label": "Kidney disease in the family"
        },
        {
          "id": "dialysis_history",
          "type": "textarea",
          "label": "Any previous dialysis or transplant"
        }
      ]
    }
  ],
