          "id": "frequency",
          "type": "text",
          "label": "How often does it happen?"
        },
        {
          "id": "witness_account",
          "type": "textarea",
          "label": "If anyone has seen an episode, what did they describe?"
        },
        {
          "id": "triggers",
          "type": "textarea",
          "label": "Anything that brings it on or makes it worse"
        },
        {
          "id": "head_injury",
          "type": "checkbox",
          "label": "Any significant head injury in the past"
        },
        {
          "id": "family_neuro",
          "type": "textarea",
          "label": "Neurological conditions in the family"
        },
        {
          "id": "medications",
          "type": "textarea",
          "label": "Current medicines, with doses",
          "required": true
