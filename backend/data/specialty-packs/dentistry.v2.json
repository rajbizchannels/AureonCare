  "formTemplates": [
    {
      "slug": "dental-intake",
      "name": "Dental Intake",
      "templateType": "onboarding",
      "fields": [
        {
          "id": "reason_for_visit",
          "type": "textarea",
          "label": "What brings you in today?",
          "required": true
        },
        {
          "id": "last_dental_visit",
          "type": "date",
          "label": "Date of last dental visit"
        },
        {
          "id": "pain_now",
          "type": "radio",
          "label": "Are you in pain at the moment?",
          "options": [
            "No",
            "Mild",
            "Moderate",
            "Severe"
          ],
          "required": true
        },
        {
          "id": "bleeding_gums",
          "type": "checkbox",
          "label": "Do your gums bleed when brushing?"
        },
        {
          "id": "grinding",
          "type": "checkbox",
          "label": "Do you grind or clench your teeth?"
        },
        {
          "id": "anaesthetic_reaction",
          "type": "textarea",
          "label": "Any previous reaction to local anaesthetic?"
        },
        {
          "id": "bisphosphonates",
          "type": "checkbox",
          "label": "Have you ever taken bisphosphonate medicines?"
        }
      ]
    },
    {
      "slug": "dental-extraction-consent",
      "name": "Consent to Extraction",
      "templateType": "consent",
      "requireSignature": true,
      "fields": [
        {
          "id": "tooth_reference",
          "type": "text",
          "label": "Tooth or teeth to be removed",
          "required": true
        },
        {
          "id": "risks_explained",
          "type": "checkbox",
          "label": "The risks have been explained to me, including bleeding, infection, swelling, bruising and possible nerve injury",
          "required": true
        },
        {
          "id": "alternatives_explained",
          "type": "checkbox",
          "label": "The alternatives to extraction have been explained to me",
          "required": true
        },
        {
          "id": "questions_answered",
          "type": "checkbox",
          "label": "I have had the chance to ask questions and they were answered",
          "required": true
        }
      ]
    },
    {
      "slug": "dental-post-op-instructions",
      "name": "Post-operative Instructions",
      "templateType": "clinical",
      "fields": [
        {
          "id": "procedure",
          "type": "text",
          "label": "Procedure carried out",
          "required": true
        },
        {
          "id": "given_to_patient",
          "type": "checkbox",
          "label": "Written instructions given to the patient",
          "required": true
        },
        {
          "id": "review_date",
          "type": "date",
          "label": "Review appointment"
        }
      ]
    },
    {
      "slug": "dental-health-history",
      "name": "Dental Health History",
      "description": "Dental patient intake form covering oral health history, concerns, medications, and medical conditions affecting dental care.",
      "templateType": "onboarding",
      "categorySlug": "dentistry",
      "version": "1.2",
      "subcategory": "Dental Intake",
      "requireSignature": true,
      "languages": [
        "en"
      ],
      "tags": [
        "dental",
        "oral health",
        "dentistry",
        "intake"
      ],
      "complianceTags": [
        "HIPAA"
      ],
      "fields": [
        {
          "id": "patient_name",
          "type": "text",
          "label": "Patient Name",
          "required": true
        },
        {
          "id": "dob",
          "type": "date",
          "label": "Date of Birth",
          "required": true
        },
        {
          "id": "heading_dental",
          "type": "heading",
          "label": "Dental History"
        },
        {
          "id": "last_visit",
          "type": "text",
          "label": "Date of last dental visit",
          "required": false
        },
        {
          "id": "dental_concerns",
          "type": "textarea",
          "label": "Current dental concerns / reason for visit",
          "required": true
        },
        {
          "id": "dental_anxiety",
          "type": "select",
          "label": "Dental anxiety level",
          "required": false,
          "options": [
            "None",
            "Mild",
            "Moderate",
            "Severe"
          ]
        },
        {
          "id": "heading_oral_history",
          "type": "heading",
          "label": "Oral Health History"
        },
        {
          "id": "oral_conditions",
          "type": "checkboxes",
          "label": "Check any that apply",
          "required": false,
          "options": [
            "Bleeding gums",
            "Sensitive teeth",
            "Dry mouth",
            "Jaw pain (TMJ)",
            "Teeth grinding/clenching",
            "Previous orthodontic treatment",
            "Dentures/partials",
            "Dental implants"
          ]
        },
        {
          "id": "heading_medical",
          "type": "heading",
          "label": "Medical Conditions Relevant to Dental Care"
        },
        {
          "id": "medical_conditions",
          "type": "checkboxes",
          "label": "Do you have any of the following?",
          "required": false,
          "options": [
            "Heart conditions (requires antibiotic premedication?)",
            "Diabetes",
            "Blood thinners",
            "Osteoporosis (bisphosphonates)",
            "HIV/AIDS",
            "Hepatitis",
            "Pregnancy",
            "None"
          ]
        },
        {
          "id": "current_medications",
          "type": "textarea",
          "label": "Current medications",
          "required": false
        },
        {
          "id": "allergies",
          "type": "textarea",
          "label": "Allergies (medications, latex, materials)",
          "required": false
        },
        {
          "id": "signature",
          "type": "signature",
          "label": "Patient Signature",
          "required": true
        }
      ]
    }
  ],
