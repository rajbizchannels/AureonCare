  "formTemplates": [
    {
      "slug": "pre-anaesthetic-assessment",
      "name": "Pre-anaesthetic Assessment",
      "templateType": "clinical",
      "categorySlug": "clinical",
      "version": "1.0",
      "languages": [
        "en"
      ],
      "complianceTags": [
        "HIPAA"
      ],
      "fields": [
        {
          "id": "planned_procedure",
          "type": "text",
          "label": "Planned procedure",
          "required": true
        },
        {
          "id": "previous_anaesthetic",
          "type": "radio",
          "label": "Have you had an anaesthetic before?",
          "options": [
            "No",
            "Yes"
          ],
          "required": true
        },
        {
          "id": "anaesthetic_problems",
          "type": "textarea",
          "label": "Any problems with an anaesthetic — sickness, slow waking, awareness"
        },
        {
          "id": "family_anaesthetic",
          "type": "checkbox",
          "label": "Has anyone in your family had a serious reaction to an anaesthetic?"
        },
        {
          "id": "airway_history",
          "type": "checkboxes",
          "label": "Do any of these apply?",
          "options": [
            "Difficult intubation in the past",
            "Limited neck movement",
            "Limited mouth opening",
            "Loose teeth, caps or crowns",
            "Sleep apnoea",
            "None of these"
          ]
        },
        {
          "id": "reflux",
          "type": "checkbox",
          "label": "Do you get heartburn or reflux?"
        },
        {
          "id": "exercise_tolerance",
          "type": "select",
          "label": "Can you climb two flights of stairs without stopping?",
          "options": [
            "Yes",
            "With difficulty",
            "No"
          ],
          "required": true
        },
        {
          "id": "medications",
          "type": "textarea",
          "label": "Current medicines, with doses",
          "required": true
        },
        {
          "id": "anticoagulants",
          "type": "radio",
          "label": "Do you take a blood thinner?",
          "options": [
            "No",
            "Yes"
          ],
          "required": true
        },
        {
          "id": "allergies",
          "type": "textarea",
          "label": "Allergies, including latex"
        },
        {
          "id": "fasting_understood",
          "type": "checkbox",
          "label": "I understand the fasting instructions I have been given",
          "required": true
        }
      ]
    }
  ],
  "inventoryCategories": [
    {
      "code": "anae_airway",
