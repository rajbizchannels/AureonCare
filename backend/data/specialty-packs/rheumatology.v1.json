  "formTemplates": [
    {
      "slug": "rheumatology-intake",
      "name": "Rheumatology Intake",
      "templateType": "onboarding",
      "categorySlug": "onboarding",
      "version": "1.0",
      "languages": [
        "en"
      ],
      "complianceTags": [
        "HIPAA"
      ],
      "fields": [
        {
          "id": "affected_joints",
          "type": "checkboxes",
          "label": "Which joints are affected?",
          "options": [
            "Hands",
            "Wrists",
            "Elbows",
            "Shoulders",
            "Neck",
            "Back",
            "Hips",
            "Knees",
            "Ankles",
            "Feet"
          ],
          "required": true
        },
        {
          "id": "morning_stiffness",
          "type": "select",
          "label": "Morning stiffness",
          "options": [
            "None",
            "Under 30 minutes",
            "30 to 60 minutes",
            "Over an hour"
          ]
        },
        {
          "id": "pattern",
          "type": "radio",
          "label": "Is the pain worse with rest or with use?",
          "options": [
            "Worse with rest, better with movement",
            "Worse with use",
            "No clear pattern"
          ]
        },
        {
          "id": "swelling",
          "type": "checkbox",
          "label": "Do the joints swell?"
        },
        {
          "id": "skin_psoriasis",
          "type": "checkbox",
          "label": "Do you have psoriasis, or has anyone in your family?"
        },
        {
          "id": "eye_symptoms",
          "type": "checkbox",
          "label": "Any red or painful eyes?"
        },
        {
          "id": "previous_dmards",
          "type": "textarea",
          "label": "Any disease-modifying drugs you have taken before, and why they stopped"
        },
        {
          "id": "infections",
          "type": "textarea",
          "label": "Any recent or recurrent infections, or TB exposure"
        },
        {
          "id": "medications",
          "type": "textarea",
          "label": "Current medicines, with doses",
          "required": true
        }
      ]
    }
  ],
