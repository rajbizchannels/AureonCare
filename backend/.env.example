# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Public URL of the backend (used for OAuth redirect URIs)
AC_BE_URL=https://your-vercel-backend.vercel.app
# Deployed frontend URL (used for CORS)
AC_FE_URL=https://your-vercel-frontend.vercel.app

# ─── Supabase ────────────────────────────────────────────────────────────────
# Supabase dashboard → Settings → API
AC_SB_URL=https://your-project-ref.supabase.co
# Publishable key — safe to use in client-side code
AC_SB_PK=your-supabase-publishable-key
# Secret key — server-side only, never expose to the browser
AC_SB_SK=your-supabase-secret-key

# ─── Database (PostgreSQL via Supabase) ──────────────────────────────────────
# Supabase dashboard → Settings → Database → Connection string → URI
# Use the "Transaction Pooler" (port 6543) for Vercel serverless deployments.
AC_PG_URI=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# Individual vars — only used when AC_PG_URI is absent (local dev)
AC_DB_H=localhost
AC_DB_P=5432
AC_DB_N=aureoncare
AC_DB_U=postgres
AC_DB_W=your-local-db-password
# Set to "true" when connecting to Supabase without AC_PG_URI
AC_DB_S=false

# ─── Security ────────────────────────────────────────────────────────────────
AC_TK_S=your-super-secret-jwt-key-min-32-chars
AC_TK_E=24h
AC_EK=your-32-byte-encryption-key-here

# ─── Redis (optional) ────────────────────────────────────────────────────────
AC_USE_RD=false
AC_RD_H=localhost
AC_RD_P=6379
# AC_RD_W=your-redis-password

# ─── Email ────────────────────────────────────────────────────────────────────
# AC_SG_KEY=your-sendgrid-key
# AC_FROM_EM=noreply@aureoncare.com
# AC_SM_H=smtp.gmail.com
# AC_SM_P=587
# AC_SM_U=your-email@gmail.com
# AC_SM_W=your-app-password
AC_CLN=AureonCare Clinic

# ─── File uploads ─────────────────────────────────────────────────────────────
# On Vercel, use /tmp for transient uploads; persist to Supabase Storage.
AC_UPL_DIR=/tmp/aureoncare/uploads
AC_UPL_MAX=10485760

# ─── Logging ─────────────────────────────────────────────────────────────────
AC_LOG_DIR=/tmp/aureoncare/logs
AC_LOG_LVL=info

# ─── Zoom OAuth ──────────────────────────────────────────────────────────────
AC_ZM_CID=your-zoom-client-id
AC_ZM_CSK=your-zoom-client-secret

# ─── Google Meet OAuth ───────────────────────────────────────────────────────
# AC_GM_CID=your-google-meet-client-id
# AC_GM_CSK=your-google-meet-client-secret

# ─── Microsoft Teams / Azure AD ──────────────────────────────────────────────
# AC_MS_CID=your-azure-client-id
# AC_MS_CSK=your-azure-client-secret

# ─── Cisco Webex ─────────────────────────────────────────────────────────────
# AC_WBX_CID=your-webex-client-id
# AC_WBX_CSK=your-webex-client-secret

# ─── Google Drive Backup OAuth ───────────────────────────────────────────────
# Create an OAuth 2.0 Web Client at console.cloud.google.com → APIs & Services
# → Credentials. Enable the Google Drive API. Add this redirect URI:
#   {AC_BE_URL}/api/integrations/oauth/google_drive/callback
# Required scopes: https://www.googleapis.com/auth/drive.file
#                  https://www.googleapis.com/auth/drive.appdata (optional)
# AC_GD_CID=your-google-drive-client-id
# AC_GD_CSK=your-google-drive-client-secret

# ─── OneDrive Backup OAuth ───────────────────────────────────────────────────
# Register an app at portal.azure.com → App registrations → New registration.
# Set redirect URI to: {AC_BE_URL}/api/integrations/oauth/onedrive/callback
# Add API permissions: Files.ReadWrite, offline_access (Microsoft Graph)
# AC_OD_CID=your-azure-app-client-id
# AC_OD_CSK=your-azure-app-client-secret
